function renderReport(){
  const months = {};
  function ensure(k){ months[k] = months[k] || {repRev:0, repParts:0, jobs:0, salesRev:0, salesProfit:0, expenses:0, damaged:0, stockAddQty:0, stockAddCost:0}; }
  repairs.forEach(r=>{ const k=monthKey(r.date); ensure(k); if(r.paid){ months[k].repRev += Number(r.cost); months[k].jobs += 1; } if(r.partUsed) months[k].repParts += Number(r.partUsed.wholesale)*Number(r.partUsed.qty); });
  expenses.forEach(e=>{ const k=monthKey(e.date); ensure(k); months[k].expenses += Number(e.amount); });
  damaged.forEach(d=>{ const k=monthKey(d.date); ensure(k); months[k].damaged += Number(d.value); });
  sales.forEach(s=>{ const k=monthKey(s.date); ensure(k); months[k].salesRev += Number(s.total); months[k].salesProfit += Number(s.profit); });
  invoices.forEach(inv=>{ const k=monthKey(inv.date); ensure(k); months[k].salesRev += Number(inv.total); months[k].salesProfit += Number(inv.profit); });
  stockLog.forEach(l=>{ const k=monthKey(l.date); ensure(k); months[k].stockAddQty += Number(l.qtyAdded); months[k].stockAddCost += Number(l.cost); });

  const keys = Object.keys(months).sort().reverse();
  let h = `<p class="section-title">التقرير الشهري</p>`;
  if(keys.length===0){ h += `<div class="empty">لسه مفيش بيانات كفاية لعرض تقرير</div>`; return h; }
  keys.forEach(k=>{
    const m = months[k];
    const profit = (m.repRev - m.repParts) + m.salesProfit - m.expenses - m.damaged;
    const open = expandedMonth===k;
    h += `<div class="report-card" onclick="toggleMonth('${k}')">
      <div class="rc-head"><span class="rc-month">${monthLabel(k)}</span><span class="rc-profit num" style="color:${profit>=0?'var(--teal)':'var(--red)'}">${money(profit)}</span></div>
      ${open?`<div class="report-detail">
        <div><span>إيراد الصيانة</span><b class="num" style="color:var(--teal)">${money(m.repRev)}</b></div>
        <div><span>عدد الصيانات المدفوعة</span><b class="num">${m.jobs}</b></div>
        <div><span>تكلفة قطع مستخدمة</span><b class="num" style="color:var(--red)">${money(m.repParts)}</b></div>
        <div><span>إيراد بيع المنتجات</span><b class="num" style="color:var(--teal)">${money(m.salesRev)}</b></div>
        <div><span>مكسب بيع المنتجات</span><b class="num" style="color:var(--teal)">${money(m.salesProfit)}</b></div>
        <div><span>مصروفات المحل</span><b class="num" style="color:var(--red)">${money(m.expenses)}</b></div>
        <div><span>خسائر التالف</span><b class="num" style="color:var(--brass-dark)">${money(m.damaged)}</b></div>
        <div><span>صافي حركة المخزون</span><b class="num">${m.stockAddQty>=0?'+':''}${m.stockAddQty} قطعة (${money(m.stockAddCost)})</b></div>
      </div>`:''}
    </div>`;
  });
  return h;
}

