<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="حسابات المحل">
<meta name="theme-color" content="#182320">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<title>دفتر حسابات المحل</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#182320; --paper:#F3EFE6; --paper-2:#EAE3D3; --card:#FFFDF8;
    --brass:#B07A34; --brass-dark:#8C5E23; --brass-light:#F1E2C9;
    --teal:#2E6659; --teal-light:#DCE9E4; --red:#A3432F; --red-light:#F3E1DB; --line:#D8CFBC;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:'Tajawal',sans-serif;-webkit-font-smoothing:antialiased;}
  .app{max-width:480px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;background:var(--paper);position:relative;padding-bottom:78px;}
  .num{font-family:'JetBrains Mono',monospace;}

  header{padding:22px 18px 16px;border-bottom:2px solid var(--ink);background:var(--paper);position:relative;}
  .gear-btn{position:absolute;top:20px;left:16px;background:none;border:1px solid var(--line);border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ink);}
  .gear-btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;}
  .shop-title{font-size:13px;letter-spacing:0.3px;color:var(--brass-dark);margin:0 0 4px;font-weight:700;}
  .shop-name{font-size:24px;font-weight:900;margin:0 0 14px;line-height:1.2;}
  .hero-row{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;}
  .hero-label{font-size:12px;color:#5b6560;margin:0 0 2px;}
  .hero-value{font-size:34px;font-weight:700;line-height:1;}
  .hero-value.pos{color:var(--teal);} .hero-value.neg{color:var(--red);}
  .hero-sub{text-align:left;font-size:12px;color:#5b6560;}
  .hero-sub .num{font-size:14px;color:var(--ink);display:block;}

  main{flex:1;padding:16px;}
  .section-title{font-size:13px;font-weight:700;color:#5b6560;margin:18px 2px 8px;display:flex;justify-content:space-between;align-items:center;}
  .section-title:first-child{margin-top:0;}

  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .stat-card{background:var(--card);border:1px solid var(--line);border-radius:4px;padding:12px 14px;}
  .stat-card .lbl{font-size:11.5px;color:#5b6560;margin-bottom:6px;}
  .stat-card .val{font-size:19px;font-weight:700;}
  .stat-card.warn .val{color:var(--brass-dark);}
  .stat-card.alert{border-color:var(--red);} .stat-card.alert .val{color:var(--red);}

  .list-item{background:var(--card);border:1px solid var(--line);border-radius:4px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:8px;}
  .list-item.low-stock{border-color:var(--red);background:linear-gradient(0deg,var(--red-light) 0%, var(--card) 14%);}
  .li-main{flex:1;min-width:0;}
  .li-title{font-size:14.5px;font-weight:700;margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .li-sub{font-size:12px;color:#5b6560;margin:0;}
  .li-note{font-size:11px;color:var(--brass-dark);margin:2px 0 0;}
  .li-right{text-align:left;flex-shrink:0;}
  .li-amount{font-size:15px;font-weight:700;}
  .li-amount.neg{color:var(--red);} .li-amount.pos{color:var(--teal);}
  .tag{display:inline-block;font-size:10px;padding:2px 6px;border-radius:3px;margin-top:3px;margin-left:3px;font-weight:700;}
  .tag.unpaid{background:var(--red-light);color:var(--red);}
  .tag.paid{background:var(--teal-light);color:var(--teal);}
  .tag.low{background:var(--red-light);color:var(--red);}
  .tag.damaged{background:var(--brass-light);color:var(--brass-dark);}
  .tag.received{background:var(--paper-2);color:#5b6560;}
  .tag.delivered{background:var(--teal-light);color:var(--teal);}
  .tag.sale{background:var(--brass-light);color:var(--brass-dark);}

  .empty{text-align:center;padding:36px 16px;color:#8a9089;font-size:13.5px;border:1px dashed var(--line);border-radius:4px;}

  .icon-btn{background:none;border:none;color:#8a9089;font-size:14px;cursor:pointer;padding:3px 4px;line-height:1;}
  .icon-btn:hover{color:var(--ink);}
  .icon-btn.danger:hover{color:var(--red);}
  .li-actions{display:flex;flex-direction:column;gap:1px;align-items:center;}

  .fab{position:fixed;left:50%;transform:translateX(-50%);bottom:88px;max-width:480px;width:calc(100% - 32px);background:var(--ink);color:var(--paper);border:none;border-radius:6px;padding:14px;font-family:'Tajawal',sans-serif;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(24,35,32,0.22);}
  .fab:active{transform:translateX(-50%) scale(0.98);}
  .fab-row{position:fixed;left:50%;transform:translateX(-50%);bottom:88px;max-width:480px;width:calc(100% - 32px);display:flex;gap:8px;}
  .fab-row .fab{position:static;transform:none;width:auto;flex:1;}
  .fab-row .fab.secondary{background:var(--brass-dark);}
  .fab-row .fab:active{transform:scale(0.98);}
  .inv-row{background:var(--card);border:1px solid var(--line);border-radius:5px;padding:10px;margin-bottom:8px;}
  .inv-row-top{display:flex;gap:8px;margin-bottom:8px;}
  .inv-row-top select{flex:1;}
  .inv-row-nums{display:flex;gap:8px;align-items:flex-end;}
  .inv-row-nums .field{flex:1;margin-bottom:0;}
  .inv-remove{background:none;border:none;color:var(--red);font-size:15px;cursor:pointer;padding:0 4px;}
  .add-row-btn{width:100%;padding:10px;border:1px dashed var(--line);border-radius:5px;background:none;color:var(--brass-dark);font-family:'Tajawal',sans-serif;font-size:13.5px;font-weight:700;cursor:pointer;margin-bottom:12px;}
  .invoice-total-bar{display:flex;justify-content:space-between;align-items:center;padding:12px 4px;border-top:1px dashed var(--line);margin-top:4px;}
  .invoice-total-bar .lbl{font-size:13px;color:#5b6560;}
  .invoice-total-bar .val{font-size:19px;font-weight:700;}

  .modal-backdrop{position:fixed;inset:0;background:rgba(24,35,32,0.45);display:flex;align-items:flex-end;justify-content:center;z-index:20;}
  .modal{background:var(--paper);width:100%;max-width:480px;border-radius:14px 14px 0 0;padding:20px 18px 26px;border-top:2px solid var(--ink);animation:slideup 0.22s ease-out;max-height:88vh;overflow-y:auto;}
  @keyframes slideup{from{transform:translateY(16px);opacity:0;}to{transform:translateY(0);opacity:1;}}
  .modal h3{margin:0 0 16px;font-size:17px;font-weight:900;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:12px;color:#5b6560;margin-bottom:5px;font-weight:700;}
  .field input, .field select{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:5px;font-family:'Tajawal',sans-serif;font-size:14.5px;background:var(--card);color:var(--ink);}
  .field input:focus, .field select:focus{outline:2px solid var(--brass);outline-offset:0;}
  .field-row{display:flex;gap:10px;} .field-row .field{flex:1;}
  .modal-actions{display:flex;gap:8px;margin-top:16px;}
  .btn{flex:1;padding:12px;border-radius:5px;font-family:'Tajawal',sans-serif;font-size:14.5px;font-weight:700;border:none;cursor:pointer;}
  .btn-cancel{background:none;border:1px solid var(--line);color:var(--ink);}
  .btn-save{background:var(--ink);color:var(--paper);}
  .toggle-row{display:flex;gap:8px;}
  .toggle-opt{flex:1;text-align:center;padding:10px;border:1px solid var(--line);border-radius:5px;font-size:13px;font-weight:700;cursor:pointer;color:#5b6560;}
  .toggle-opt.active-a{background:var(--teal-light);border-color:var(--teal);color:var(--teal);}
  .toggle-opt.active-b{background:var(--red-light);border-color:var(--red);color:var(--red);}
  .toggle-opt.active-c{background:var(--brass-light);border-color:var(--brass);color:var(--brass-dark);}
  .hint{font-size:11.5px;color:#5b6560;margin:-4px 0 12px;}

  .report-card{background:var(--card);border:1px solid var(--line);border-radius:4px;padding:14px;margin-bottom:10px;cursor:pointer;}
  .report-card .rc-head{display:flex;justify-content:space-between;align-items:center;}
  .report-card .rc-month{font-size:14.5px;font-weight:700;}
  .report-card .rc-profit{font-size:16px;font-weight:700;}
  .report-detail{margin-top:12px;padding-top:12px;border-top:1px dashed var(--line);display:grid;grid-template-columns:1fr 1fr;gap:9px;font-size:12.5px;}
  .report-detail div span{display:block;color:#5b6560;font-size:11px;}
  .report-detail div b{font-size:14px;}

  nav{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;background:var(--card);border-top:2px solid var(--ink);display:flex;z-index:10;}
  .nav-btn{flex:1;background:none;border:none;padding:10px 2px 8px;font-family:'Tajawal',sans-serif;font-size:10.6px;font-weight:700;color:#8a9089;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;position:relative;}
  .nav-btn svg{width:19px;height:19px;stroke:#8a9089;fill:none;stroke-width:1.8;}
  .nav-btn.active{color:var(--ink);}
  .nav-btn.active svg{stroke:var(--brass-dark);}
  .nav-btn.active::after{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:20px;height:2px;background:var(--brass);}
  .nav-dot{position:absolute;top:5px;left:calc(50% + 9px);width:7px;height:7px;border-radius:50%;background:var(--red);}

  .loading{text-align:center;padding:60px 20px;color:#8a9089;font-size:13.5px;}
  .backup-row{display:flex;flex-direction:column;gap:10px;}
  .backup-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:13px;border-radius:5px;border:1px solid var(--line);background:var(--card);font-family:'Tajawal',sans-serif;font-size:14px;font-weight:700;color:var(--ink);cursor:pointer;}
</style>
</head>
<body>
<div class="app" id="app">
  <div class="loading" id="loading">جارِ تحميل البيانات...</div>
</div>
<input type="file" id="importFile" accept="application/json" style="display:none">

<script>
const K_REPAIRS='repairs', K_EXPENSES='expenses', K_PARTS='parts', K_DAMAGED='damaged', K_SALES='sales', K_STOCKLOG='stockLog', K_INVOICES='invoices';

let repairs=[], expenses=[], parts=[], damaged=[], sales=[], stockLog=[], invoices=[];
let activeTab='home';
let modalOpen=null; // repair|expense|part|damaged|sell|invoice|settings
let paidState=false, statusState='received';
let editingPartId=null, damagedForPartId=null, sellForPartId=null, adjustQtyForPartId=null;
let expandedMonth=null, expandedInvoiceId=null;
let draftInvoice=[];
let deferredPromptEvent=null;
window.addEventListener('beforeinstallprompt', function(e){ e.preventDefault(); deferredPromptEvent=e; });
if('serviceWorker' in navigator){
  window.addEventListener('load', function(){
    navigator.serviceWorker.register('sw.js').catch(function(err){ console.error('SW registration failed', err); });
  });
}

const app = document.getElementById('app');

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function todayStr(){ return new Date().toLocaleDateString('ar-EG', { day:'numeric', month:'short' }); }
function fullDate(ts){ return new Date(ts).toLocaleDateString('ar-EG', { day:'numeric', month:'short', year:'numeric' }); }
function monthKey(ts){ const d=new Date(ts); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'); }
function monthLabel(key){ const [y,m]=key.split('-'); const d=new Date(Number(y), Number(m)-1, 1); return d.toLocaleDateString('ar-EG',{month:'long', year:'numeric'}); }
function money(n){ return Number(n).toLocaleString('en-US', {maximumFractionDigits:0}); }
function escapeHtml(s){ const d=document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

const STORAGE_PREFIX = 'shop_accounts_';

async function loadData(){
  const map = [['repairs',K_REPAIRS],['expenses',K_EXPENSES],['parts',K_PARTS],['damaged',K_DAMAGED],['sales',K_SALES],['stockLog',K_STOCKLOG],['invoices',K_INVOICES]];
  for(const [v,key] of map){
    try{ const raw = localStorage.getItem(STORAGE_PREFIX+key); const val = raw ? JSON.parse(raw) : []; setVar(v,val); }
    catch(e){ setVar(v,[]); }
  }
  render();
}
function setVar(name,val){
  if(name==='repairs') repairs=val;
  if(name==='expenses') expenses=val;
  if(name==='parts') parts=val;
  if(name==='damaged') damaged=val;
  if(name==='sales') sales=val;
  if(name==='stockLog') stockLog=val;
  if(name==='invoices') invoices=val;
}
async function saveRepairs(){ try{ localStorage.setItem(STORAGE_PREFIX+K_REPAIRS, JSON.stringify(repairs)); }catch(e){console.error(e);} }
async function saveExpenses(){ try{ localStorage.setItem(STORAGE_PREFIX+K_EXPENSES, JSON.stringify(expenses)); }catch(e){console.error(e);} }
async function saveParts(){ try{ localStorage.setItem(STORAGE_PREFIX+K_PARTS, JSON.stringify(parts)); }catch(e){console.error(e);} }
async function saveDamaged(){ try{ localStorage.setItem(STORAGE_PREFIX+K_DAMAGED, JSON.stringify(damaged)); }catch(e){console.error(e);} }
async function saveSales(){ try{ localStorage.setItem(STORAGE_PREFIX+K_SALES, JSON.stringify(sales)); }catch(e){console.error(e);} }
async function saveStockLog(){ try{ localStorage.setItem(STORAGE_PREFIX+K_STOCKLOG, JSON.stringify(stockLog)); }catch(e){console.error(e);} }
async function saveInvoices(){ try{ localStorage.setItem(STORAGE_PREFIX+K_INVOICES, JSON.stringify(invoices)); }catch(e){console.error(e);} }

function totals(){
  const paidRepairs = repairs.filter(r=>r.paid);
  const repairsRevenue = paidRepairs.reduce((s,r)=>s+Number(r.cost),0);
  const repairsPartsCost = repairs.reduce((s,r)=> s + (r.partUsed? Number(r.partUsed.wholesale)*Number(r.partUsed.qty) : 0), 0);
  const pendingCount = repairs.filter(r=>!r.paid).length;
  const pendingSum = repairs.filter(r=>!r.paid).reduce((s,r)=>s+Number(r.cost),0);
  const notDelivered = repairs.filter(r=>r.status!=='delivered').length;
  const expTotal = expenses.reduce((s,e)=>s+Number(e.amount),0);
  const damagedTotal = damaged.reduce((s,d)=>s+Number(d.value),0);
  const salesRevenue = sales.reduce((s,x)=>s+Number(x.total),0) + invoices.reduce((s,x)=>s+Number(x.total),0);
  const salesProfit = sales.reduce((s,x)=>s+Number(x.profit),0) + invoices.reduce((s,x)=>s+Number(x.profit),0);
  const lowStock = parts.filter(p=>Number(p.qty) <= Number(p.threshold));
  const stockValue = parts.reduce((s,p)=>s+Number(p.qty)*Number(p.wholesale),0);
  const profit = (repairsRevenue - repairsPartsCost) + salesProfit - expTotal - damagedTotal;
  return {repairsRevenue, repairsPartsCost, pendingCount, pendingSum, notDelivered, expTotal, damagedTotal, salesRevenue, salesProfit, lowStock, stockValue, profit};
}

function icon(name){
  const icons = {
    home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
    wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2.6-.6-.6-2.6 2.8-2.8Z"/>',
    coin: '<circle cx="12" cy="12" r="9"/><path d="M9 9.5c0-1 1-1.8 3-1.8s3 .8 3 1.8-1 1.5-3 1.8-3 .8-3 1.9 1.3 1.8 3 1.8 3-.8 3-1.8"/>',
    box: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>',
    chart: '<path d="M4 19V10"/><path d="M11 19V5"/><path d="M18 19v-7"/><path d="M3 19h18"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z"/>',
    cart: '<circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M3 4h2l2.3 11.4a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.6L21 8H6"/>',
    receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6"/><path d="M9 12h6"/>'
  };
  return '<svg viewBox="0 0 24 24">'+icons[name]+'</svg>';
}

function render(){
  document.getElementById('loading')?.remove();
  const t = totals();

  let html = `
    <header>
      <button class="gear-btn" onclick="openModal('settings')">${icon('gear')}</button>
      <p class="shop-title">دفتر الحسابات</p>
      <h1 class="shop-name">محل الصيانة</h1>
      <div class="hero-row">
        <div>
          <p class="hero-label">صافي الربح</p>
          <p class="hero-value ${t.profit>=0?'pos':'neg'} num">${money(t.profit)} ج.م</p>
        </div>
        <div class="hero-sub">
          <span>اليوم ${todayStr()}</span>
          <span class="num">${repairs.length} صيانة · ${parts.length} صنف</span>
        </div>
      </div>
    </header>
    <main>
  `;

  if(activeTab==='home') html += renderHome(t);
  if(activeTab==='repairs') html += renderRepairs();
  if(activeTab==='inventory') html += renderInventory(t);
  if(activeTab==='expenses') html += renderExpenses();
  if(activeTab==='report') html += renderReport();

  html += `</main>`;

  if(activeTab==='repairs') html += `<button class="fab" onclick="openModal('repair')">+ استلام جهاز للصيانة</button>`;
  if(activeTab==='expenses') html += `<button class="fab" onclick="openModal('expense')">+ إضافة مصروف</button>`;
  if(activeTab==='inventory') html += `<div class="fab-row"><button class="fab" onclick="openModal('part')">+ إضافة منتج</button><button class="fab secondary" onclick="openInvoiceModal()">+ فاتورة بيع</button></div>`;

  html += `
    <nav>
      <button class="nav-btn ${activeTab==='home'?'active':''}" onclick="setTab('home')">${icon('home')}<span>الرئيسية</span></button>
      <button class="nav-btn ${activeTab==='repairs'?'active':''}" onclick="setTab('repairs')">${icon('wrench')}<span>الصيانة</span>${t.notDelivered>0?'<span class="nav-dot"></span>':''}</button>
      <button class="nav-btn ${activeTab==='inventory'?'active':''}" onclick="setTab('inventory')">${icon('box')}<span>المخزون</span>${t.lowStock.length>0?'<span class="nav-dot"></span>':''}</button>
      <button class="nav-btn ${activeTab==='expenses'?'active':''}" onclick="setTab('expenses')">${icon('coin')}<span>المصروفات</span></button>
      <button class="nav-btn ${activeTab==='report'?'active':''}" onclick="setTab('report')">${icon('chart')}<span>التقرير</span></button>
    </nav>
  `;

  if(modalOpen==='repair') html += repairModalHtml();
  if(modalOpen==='expense') html += expenseModalHtml();
  if(modalOpen==='part') html += partModalHtml();
  if(modalOpen==='damaged') html += damagedModalHtml();
  if(modalOpen==='sell') html += sellModalHtml();
  if(modalOpen==='invoice') html += invoiceModalHtml();
  if(modalOpen==='adjustqty') html += adjustQtyModalHtml();
  if(modalOpen==='settings') html += settingsModalHtml();
  if(modalOpen==='install') html += installModalHtml();

  app.innerHTML = html;
  if(modalOpen==='settings'){
    document.getElementById('importFile').onchange = handleImportFile;
  }
}

function renderHome(t){
  let h = `
    <p class="section-title">نظرة عامة</p>
    <div class="stat-grid">
      <div class="stat-card"><p class="lbl">إيراد الصيانة</p><p class="val num" style="color:var(--teal)">${money(t.repairsRevenue)}</p></div>
      <div class="stat-card"><p class="lbl">مكسب بيع المنتجات</p><p class="val num" style="color:var(--teal)">${money(t.salesProfit)}</p></div>
      <div class="stat-card"><p class="lbl">مصروفات المحل</p><p class="val num" style="color:var(--red)">${money(t.expTotal)}</p></div>
      <div class="stat-card"><p class="lbl">خسائر بضاعة تالفة</p><p class="val num" style="color:var(--brass-dark)">${money(t.damagedTotal)}</p></div>
      <div class="stat-card warn"><p class="lbl">مستحقات لم تُحصَّل</p><p class="val num">${money(t.pendingSum)}</p></div>
      <div class="stat-card"><p class="lbl">قيمة المخزون (جملة)</p><p class="val num">${money(t.stockValue)}</p></div>
      <div class="stat-card ${t.lowStock.length>0?'alert':''}"><p class="lbl">أصناف قاربت تخلص</p><p class="val num">${t.lowStock.length}</p></div>
      <div class="stat-card ${t.notDelivered>0?'alert':''}"><p class="lbl">أجهزة لسه في المحل</p><p class="val num">${t.notDelivered}</p></div>
    </div>
  `;
  if(t.lowStock.length>0){
    h += `<p class="section-title">تنبيه نقص مخزون</p>`;
    t.lowStock.forEach(p=>{
      h += `<div class="list-item low-stock"><div class="li-main"><p class="li-title">${escapeHtml(p.name)}</p><p class="li-sub">الكمية الحالية: ${p.qty} · الحد الأدنى: ${p.threshold}</p></div><span class="tag low">وشيك النفاد</span></div>`;
    });
  }
  h += `<p class="section-title">آخر النشاط</p>`;
  const combined = [
    ...repairs.map(r=>({...r,_type:'repair'})),
    ...expenses.map(e=>({...e,_type:'expense'})),
    ...sales.map(s=>({...s,_type:'sale'})),
    ...invoices.map(i=>({...i,_type:'invoice'}))
  ].sort((a,b)=>b.date-a.date).slice(0,6);
  if(combined.length===0){ h += `<div class="empty">لسه مفيش أي عمليات مسجّلة</div>`; }
  else { combined.forEach(item=>{
    if(item._type==='repair') h += repairItemHtml(item);
    else if(item._type==='sale') h += saleItemHtml(item);
    else if(item._type==='invoice') h += invoiceItemHtml(item);
    else h += expenseItemHtml(item);
  }); }
  return h;
}

