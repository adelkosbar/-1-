  const total = draftInvoice.reduce((s,r)=>s+(Number(r.qty)||0)*(Number(r.unitPrice)||0),0);
  return `<div class="modal-backdrop" onclick="closeModalBg(event)">
    <div class="modal" onclick="event.stopPropagation()">
      <h3>فاتورة بيع</h3>
      <div id="invoice-rows">${rowsHtml}</div>
      <button class="add-row-btn" onclick="addInvoiceRow()">+ إضافة صنف تاني للفاتورة</button>
      <div class="invoice-total-bar"><span class="lbl">إجمالي الفاتورة</span><span class="val num" id="invoice-total-display">${money(total)}</span></div>
      <div class="modal-actions">
        <button class="btn btn-cancel" onclick="closeModal()">إلغاء</button>
        <button class="btn btn-save" onclick="submitInvoice()">حفظ الفاتورة</button>
      </div>
    </div>
  </div>`;
}
function settingsModalHtml(){
  return `<div class="modal-backdrop" onclick="closeModalBg(event)">
    <div class="modal" onclick="event.stopPropagation()">
      <h3>النسخة الاحتياطية</h3>
      <p class="hint" style="margin-bottom:14px">بياناتك متخزنة على الجهاز ده بس (مش على أي سيرفر أو حساب). لو غيّرت المتصفح أو مسحت بيانات المتصفح أو استخدمت جهاز تاني، البيانات مش هتكون موجودة هناك — عشان كده صدّر نسخة احتياطية بشكل دوري واحفظها (واتساب لنفسك، إيميل، أو ملفات الهاتف)، وتقدر تستوردها في أي وقت على أي جهاز ترجع بيها كل حاجة زي ما كانت.</p>
      <div class="backup-row">
        <button class="backup-btn" onclick="handleInstallClick()">📲 تثبيت التطبيق على الشاشة الرئيسية</button>
        <button class="backup-btn" onclick="exportBackup()">⬇ تصدير نسخة احتياطية</button>
        <button class="backup-btn" onclick="document.getElementById('importFile').click()">⬆ استيراد نسخة احتياطية</button>
      </div>
      <div class="modal-actions"><button class="btn btn-cancel" onclick="closeModal()">إغلاق</button></div>
    </div>
  </div>`;
}
function detectPlatform(){
  const ua = navigator.userAgent || '';
  if(/iPhone|iPad|iPod/.test(ua)) return 'ios';
  if(/Android/.test(ua)) return 'android';
  return 'desktop';
}
function installModalHtml(){
  const platform = detectPlatform();
  let steps = '';
  if(platform==='ios'){
    steps = `
      <p class="li-sub" style="margin-bottom:8px">١. دوس على زرار المشاركة (Share) تحت في متصفح Safari</p>
      <p class="li-sub" style="margin-bottom:8px">٢. مرّر لحد ما تلاقي "إضافة إلى الشاشة الرئيسية" (Add to Home Screen)</p>
      <p class="li-sub">٣. دوس "إضافة" — هيظهر أيقونة التطبيق في شاشتك الرئيسية</p>
    `;
  } else if(platform==='android'){
    steps = `
      <p class="li-sub" style="margin-bottom:8px">١. دوس على أيقونة الثلاث نقط ⋮ فوق في المتصفح</p>
      <p class="li-sub" style="margin-bottom:8px">٢. اختار "إضافة إلى الشاشة الرئيسية" أو "تثبيت التطبيق"</p>
      <p class="li-sub">٣. أكّد — هيظهر أيقونة التطبيق زي أي تطبيق تاني</p>
    `;
  } else {
    steps = `
      <p class="li-sub" style="margin-bottom:8px">افتح الصفحة من متصفح على الموبايل (Chrome أو Safari) بدل الكمبيوتر</p>
      <p class="li-sub">وبعدين هتلاقي خيار "إضافة إلى الشاشة الرئيسية" من قايمة المتصفح</p>
    `;
  }
  return `<div class="modal-backdrop" onclick="closeModalBg(event)">
    <div class="modal" onclick="event.stopPropagation()">
      <h3>تثبيت التطبيق على الشاشة الرئيسية</h3>
      ${steps}
      <div class="modal-actions"><button class="btn btn-save" onclick="closeModal()">تمام، فهمت</button></div>
    </div>
  </div>`;
}
async function handleInstallClick(){
  if(deferredPromptEvent){
    modalOpen=null; render();
    deferredPromptEvent.prompt();
    try{ await deferredPromptEvent.userChoice; }catch(e){}
    deferredPromptEvent=null;
  } else {
    modalOpen='install'; render();
  }
}

function setTab(tab){ activeTab=tab; expandedMonth=null; render(); }
function openModal(type){ modalOpen=type; paidState=false; statusState='received'; render(); }
function closeModal(){ modalOpen=null; editingPartId=null; damagedForPartId=null; sellForPartId=null; render(); }
function closeModalBg(ev){ if(ev.target.classList.contains('modal-backdrop')) closeModal(); }
function setPaid(val){ paidState=val; render(); }
function setStatus(val){ statusState=val; render(); }
function toggleMonth(k){ expandedMonth = expandedMonth===k ? null : k; render(); }

async function toggleDeliveryStatus(id){
  const r = repairs.find(x=>x.id===id);
  r.status = r.status==='delivered' ? 'received' : 'delivered';
  render(); await saveRepairs();
}

async function submitRepair(){
  const customer=document.getElementById('f-customer').value.trim();
  const device=document.getElementById('f-device').value.trim();
  const issue=document.getElementById('f-issue').value.trim();
  const cost=parseFloat(document.getElementById('f-cost').value);
  const partId=document.getElementById('f-partused').value;
  const partQty=parseFloat(document.getElementById('f-partqty')?.value || '1');
  if(!customer||!device||isNaN(cost)){ alert('من فضلك املأ اسم العميل والجهاز والسعر'); return; }
  let partUsed=null;
  if(partId){
    const p = parts.find(x=>x.id===partId);
    if(!p || partQty>Number(p.qty)){ alert('الكمية المطلوبة من القطعة غير متاحة في المخزون'); return; }
    p.qty = Number(p.qty) - partQty;
    partUsed = {partId:p.id, partName:p.name, qty:partQty, wholesale:Number(p.wholesale)};
  }
  repairs.push({id:uid(), customer, device, issue: issue||'—', cost, paid:paidState, status:statusState, partUsed, date:Date.now()});
  modalOpen=null; render();
  await saveRepairs(); if(partUsed) await saveParts();
}
async function submitExpense(){
  const desc=document.getElementById('f-desc').value.trim();
  const category=document.getElementById('f-category').value;
  const amount=parseFloat(document.getElementById('f-amount').value);
  if(!desc||isNaN(amount)){ alert('من فضلك اكتب الوصف والمبلغ'); return; }
  expenses.push({id:uid(), desc, category, amount, date:Date.now()});
  modalOpen=null; render(); await saveExpenses();
}
async function submitPart(){
  const name=document.getElementById('f-pname').value.trim();
  const qty=parseFloat(document.getElementById('f-pqty').value);
  const threshold=parseFloat(document.getElementById('f-pthreshold').value);
  const wholesale=parseFloat(document.getElementById('f-pwholesale').value);
  const sell=parseFloat(document.getElementById('f-psell').value);
  if(!name||isNaN(qty)||isNaN(wholesale)||isNaN(sell)){ alert('من فضلك املأ اسم المنتج والكمية وسعر الجملة وسعر البيع'); return; }
  let logEntry=null;
  if(editingPartId){
    const p = parts.find(x=>x.id===editingPartId);
    const oldQty = Number(p.qty);
    p.name=name; p.qty=qty; p.threshold=isNaN(threshold)?2:threshold; p.wholesale=wholesale; p.sell=sell;
    if(qty>oldQty){ const delta=qty-oldQty; logEntry={id:uid(), partId:p.id, partName:name, qtyAdded:delta, cost:delta*wholesale, date:Date.now()}; }
  } else {
    const newPart={id:uid(), name, qty, threshold:isNaN(threshold)?2:threshold, wholesale, sell, date:Date.now()};
    parts.push(newPart);
    logEntry={id:uid(), partId:newPart.id, partName:name, qtyAdded:qty, cost:qty*wholesale, date:Date.now()};
  }
  modalOpen=null; editingPartId=null; render();
  await saveParts();
  if(logEntry){ stockLog.push(logEntry); await saveStockLog(); }
}
async function submitDamaged(){
  const p = parts.find(x=>x.id===damagedForPartId);
  const qty=parseFloat(document.getElementById('f-dqty').value);
  const reason=document.getElementById('f-dreason').value.trim();
  if(!p||isNaN(qty)||qty<=0){ alert('من فضلك اكتب كمية صحيحة'); return; }
  if(qty>Number(p.qty)){ alert('الكمية التالفة أكبر من الكمية المتاحة في المخزون'); return; }
  p.qty = Number(p.qty) - qty;
  damaged.push({id:uid(), partId:p.id, partName:p.name, qty, value: qty*Number(p.wholesale), reason, date:Date.now()});
  modalOpen=null; damagedForPartId=null; render();
  await saveParts(); await saveDamaged();
}
async function submitSale(){
  const p = parts.find(x=>x.id===sellForPartId);
  const qty=parseFloat(document.getElementById('f-sqty').value);
  const price=parseFloat(document.getElementById('f-sprice').value);
  if(!p||isNaN(qty)||qty<=0||isNaN(price)){ alert('من فضلك اكتب كمية وسعر صحيحين'); return; }
  if(qty>Number(p.qty)){ alert('الكمية المطلوبة أكبر من المتاح في المخزون'); return; }
  p.qty = Number(p.qty) - qty;
  const total = qty*price;
  const profit = (price - Number(p.wholesale))*qty;
  sales.push({id:uid(), partId:p.id, partName:p.name, qty, unitPrice:price, wholesale:Number(p.wholesale), total, profit, date:Date.now()});
  modalOpen=null; sellForPartId=null; render();
  await saveParts(); await saveSales();
}

function editPart(id){ editingPartId=id; modalOpen='part'; render(); }
function openDamagedModal(id){ damagedForPartId=id; modalOpen='damaged'; render(); }
function openSellModal(id){ sellForPartId=id; modalOpen='sell'; render(); }
function openAdjustQtyModal(id){ adjustQtyForPartId=id; statusState='received'; modalOpen='adjustqty'; render(); }
async function submitAdjustQty(){
  const p = parts.find(x=>x.id===adjustQtyForPartId);
  const qty = parseFloat(document.getElementById('f-aqty').value);
  if(!p||isNaN(qty)||qty<=0){ alert('من فضلك اكتب كمية صحيحة'); return; }
  const isAdd = statusState==='received';
  if(!isAdd && qty>Number(p.qty)){ alert('الكمية المطلوب خصمها أكبر من الكمية المتاحة في المخزون'); return; }
  const signedQty = isAdd ? qty : -qty;
  p.qty = Number(p.qty) + signedQty;
  stockLog.push({id:uid(), partId:p.id, partName:p.name, qtyAdded:signedQty, cost: signedQty*Number(p.wholesale), date:Date.now()});
  modalOpen=null; adjustQtyForPartId=null; render();
  await saveParts(); await saveStockLog();
}
function openInvoiceModal(){ draftInvoice=[{partId:'',qty:1,unitPrice:0}]; modalOpen='invoice'; render(); }
function addInvoiceRow(){ draftInvoice.push({partId:'',qty:1,unitPrice:0}); render(); }
function removeInvoiceRow(idx){ draftInvoice.splice(idx,1); render(); }
function onInvoicePartChange(idx, partId){
  const p = parts.find(x=>x.id===partId);
  draftInvoice[idx].partId = partId;
  draftInvoice[idx].unitPrice = p ? Number(p.sell) : 0;
  render();
}
function onInvoiceQtyInput(idx, val){ draftInvoice[idx].qty = parseFloat(val)||0; updateInvoiceTotalDisplay(); }
function onInvoicePriceInput(idx, val){ draftInvoice[idx].unitPrice = parseFloat(val)||0; updateInvoiceTotalDisplay(); }
function updateInvoiceTotalDisplay(){
  const el = document.getElementById('invoice-total-display');
  if(!el) return;
  const total = draftInvoice.reduce((s,r)=>s+(Number(r.qty)||0)*(Number(r.unitPrice)||0),0);
  el.textContent = money(total);
}
function toggleInvoice(id){ expandedInvoiceId = expandedInvoiceId===id ? null : id; render(); }

async function submitInvoice(){
  const rows = draftInvoice.filter(r=>r.partId && Number(r.qty)>0);
  if(rows.length===0){ alert('من فضلك اختار صنف واحد على الأقل وحدد الكمية'); return; }
  const neededByPart = {};
  for(const r of rows){ neededByPart[r.partId] = (neededByPart[r.partId]||0) + Number(r.qty); }
  for(const partId in neededByPart){
    const p = parts.find(x=>x.id===partId);
    if(!p || neededByPart[partId] > Number(p.qty)){
      alert('الكمية المطلوبة من "'+(p?p.name:'صنف')+'" أكبر من المتاح في المخزون');
      return;
    }
  }
  const items = rows.map(r=>{
    const p = parts.find(x=>x.id===r.partId);
    const qty = Number(r.qty), unitPrice = Number(r.unitPrice)||0, wholesale = Number(p.wholesale);
    return {partId:p.id, partName:p.name, qty, unitPrice, wholesale, lineTotal: qty*unitPrice, lineProfit:(unitPrice-wholesale)*qty};
  });
  for(const partId in neededByPart){
    const p = parts.find(x=>x.id===partId);
    p.qty = Number(p.qty) - neededByPart[partId];
  }
  const total = items.reduce((s,it)=>s+it.lineTotal,0);
  const profit = items.reduce((s,it)=>s+it.lineProfit,0);
  invoices.push({id:uid(), items, total, profit, date:Date.now()});
  modalOpen=null; draftInvoice=[]; render();
  await saveParts(); await saveInvoices();
}
async function deleteInvoice(id){ invoices=invoices.filter(i=>i.id!==id); render(); await saveInvoices(); }

async function deleteRepair(id){ repairs=repairs.filter(r=>r.id!==id); render(); await saveRepairs(); }
async function deleteExpense(id){ expenses=expenses.filter(e=>e.id!==id); render(); await saveExpenses(); }
async function deletePart(id){ if(!confirm('حذف المنتج نهائياً؟')) return; parts=parts.filter(p=>p.id!==id); render(); await saveParts(); }
async function deleteDamaged(id){ damaged=damaged.filter(d=>d.id!==id); render(); await saveDamaged(); }
async function deleteSale(id){ sales=sales.filter(s=>s.id!==id); render(); await saveSales(); }

function exportBackup(){
  const backup = { exportedAt:new Date().toISOString(), repairs, expenses, parts, damaged, sales, stockLog, invoices };
  const blob = new Blob([JSON.stringify(backup,null,2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'نسخة-احتياطية-'+new Date().toISOString().slice(0,10)+'.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function handleImportFile(ev){
  const file = ev.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async function(e){
    try{
      const data = JSON.parse(e.target.result);
      if(!confirm('استيراد النسخة الاحتياطية هيستبدل كل البيانات الحالية. متأكد؟')) return;
      repairs = data.repairs||[]; expenses = data.expenses||[]; parts = data.parts||[];
      damaged = data.damaged||[]; sales = data.sales||[]; stockLog = data.stockLog||[]; invoices = data.invoices||[];
      await saveRepairs(); await saveExpenses(); await saveParts(); await saveDamaged(); await saveSales(); await saveStockLog(); await saveInvoices();
      modalOpen=null; render();
      alert('تم استرجاع النسخة الاحتياطية بنجاح');
    }catch(err){ alert('الملف غير صالح، تأكد إنه نفس ملف النسخة الاحتياطية'); }
  };
  reader.readAsText(file);
}

loadData();
